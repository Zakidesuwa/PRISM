# Copy this file to .env and adjust.

# Database. The default matches docker-compose.yml: run `docker compose up -d`.
# Any PostgreSQL works (Neon, Supabase, Vercel Postgres...).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prism?schema=public"

# Signs the login session cookie. Required in production; use a long random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-value"
