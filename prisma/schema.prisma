// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CASHIER
  MANAGER
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  password     String
  name         String
  role         Role          @default(CASHIER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  auditLogs    AuditLog[]
}

model SchoolBranch {
  id            Int          @id @default(autoincrement())
  name          String
  address       String
  level         String       // Elementary, High School, College
  monthlyProfit Decimal      @default(0.00) @db.Decimal(10, 2)
  stockStatus   String       @default("In Stock") // In Stock, Low Stock, Stock Out
  members       CoopMember[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model CoopMember {
  id                   Int           @id @default(autoincrement())
  memberCode           String        @unique
  fullName             String
  email                String?
  phone                String?
  branchId             Int
  branch               SchoolBranch  @relation(fields: [branchId], references: [id])
  status               String        @default("ACTIVE") // ACTIVE, INACTIVE
  shareCapital         Decimal       @default(0.00) @db.Decimal(10, 2)
  accumulatedPatronage Decimal       @default(0.00) @db.Decimal(10, 2)
  transactions         Transaction[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Product {
  id               Int                 @id @default(autoincrement())
  name             String
  sku              String              @unique
  category         String
  price            Decimal             @db.Decimal(10, 2)
  stock            Int                 @default(0)
  image            String?
  ingredients      ProductIngredient[]
  transactionItems TransactionItem[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model InventoryItem {
  id                 Int                 @id @default(autoincrement())
  name               String
  packaging          String
  sku                String              @unique
  category           String
  supplier           String
  deliveryDays       String
  price              Decimal             @db.Decimal(10, 2)
  stock              Decimal             @default(0.000) @db.Decimal(10, 3)
  unit               String
  status             String              @default("Optimal") // Optimal, Low Stock, Empty
  productIngredients ProductIngredient[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model ProductIngredient {
  id               Int           @id @default(autoincrement())
  productId        Int
  inventoryItemId  Int
  quantityRequired Decimal       @db.Decimal(10, 3)
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())

  @@unique([productId, inventoryItemId])
}

model Transaction {
  id                String            @id @default(cuid())
  transactionNumber String            @unique
  cashierId         String
  cashier           User              @relation(fields: [cashierId], references: [id])
  memberId          Int?
  member            CoopMember?       @relation(fields: [memberId], references: [id])
  subtotal          Decimal           @db.Decimal(10, 2)
  taxAmount         Decimal           @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  paymentMethod     String            @default("CASH")
  status            String            @default("COMPLETED") // COMPLETED, VOIDED
  items             TransactionItem[]
  createdAt         DateTime          @default(now())
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  timestamp  DateTime @default(now())
}
